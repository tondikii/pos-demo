# Copy to .env and fill real values — never commit .env

# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/larispos
JWT_SECRET=change-me-32-chars-min
JWT_REFRESH_SECRET=change-me-refresh-32-chars
API_PORT=3001
CORS_ORIGINS=https://app.larispos.id,https://larispos.id,http://localhost:3000,http://localhost:4321

# Midtrans (Sandbox defaults — set IS_PRODUCTION=true for prod)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# Web (SolidStart)
VITE_API_URL=http://localhost:3001
# or for prod: https://api.larispos.id

# Neon / Postgres (used by packages/db)
# DATABASE_URL is the single source — see above
