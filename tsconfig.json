{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@larispos/shared": ["packages/shared/src"],
      "@larispos/shared/*": ["packages/shared/src/*"],
      "@larispos/db": ["packages/db/src"],
      "@larispos/db/*": ["packages/db/src/*"]
    }
  }
}
