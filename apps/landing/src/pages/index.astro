---
import Layout from '../layouts/Layout.astro'
import { PLANS } from '../lib/pricing'
import { FAQS, productJsonLd } from '../lib/seo'

/** Format angka ke rupiah penuh: 39000 → "Rp 39.000" */
const formatIDR = (n: number) => 'Rp ' + n.toLocaleString('id-ID')

/** Format angka ke ribuan: 39000 → "Rp 39rb", 32500 → "Rp 32,5rb" */
const ribuan = (n: number) =>
  'Rp ' + (n / 1000).toLocaleString('id-ID', { maximumFractionDigits: 1 }) + 'rb'

const features = [
  {
    icon: 'bolt',
    title: 'Kasir Cepat',
    desc: 'Satu transaksi selesai di bawah 15 detik — tap produk, bayar, struk keluar. Pelanggan tidak antre lama di jam ramai.',
  },
  {
    icon: 'wifi-off',
    title: 'Offline-First',
    desc: 'Internet mati? Tetap jualan. Transaksi tersimpan di perangkat dan otomatis tersinkron ke cloud begitu internet kembali.',
  },
  {
    icon: 'chart',
    title: 'Laporan Laba Otomatis',
    desc: 'Omzet dikurangi HPP dihitung otomatis setiap hari. Tahu untung-rugi usaha tanpa buka-buka Excel.',
  },
  {
    icon: 'box',
    title: 'Stok per Varian',
    desc: 'Pantau stok per ukuran, level, dan varian topping. Dapat peringatan otomatis saat stok mau habis.',
  },
  {
    icon: 'store',
    title: 'Multi-Outlet',
    desc: 'Kelola hingga 3 cabang (paket Tumbuh) dalam satu akun — laporan per cabang maupun gabungan dalam satu tampilan.',
  },
  {
    icon: 'printer',
    title: 'Cetak Struk Bluetooth',
    desc: 'Cetak struk thermal 58/80mm lewat printer Bluetooth atau USB. Tanpa ribet kabel dan instalasi driver.',
  },
]

const plans = [
  {
    ...PLANS.starter,
    tagline: 'Untuk warung & usaha 1 outlet',
    features: [
      '1 outlet',
      '2 kasir aktif',
      'Kasir cepat <15 detik',
      'Offline-first',
      'Laporan laba otomatis',
      'Stok per varian',
      'Cetak struk Bluetooth',
    ],
    featured: false,
  },
  {
    ...PLANS.tumbuh,
    tagline: 'Untuk usaha yang mulai buka cabang',
    features: [
      '3 outlet',
      '5 kasir per outlet',
      'Laporan gabungan semua cabang',
      'Semua fitur Starter',
      'Prioritas dukungan',
    ],
    featured: true,
  },
  {
    ...PLANS.jaringan,
    tagline: 'Untuk jaringan & franchise',
    features: [
      'Hingga 99 outlet',
      'Outlet tambahan Rp 25rb/outlet',
      'Laporan konsolidasi',
      'Onboarding & training khusus',
      'Penyesuaian harga (custom)',
    ],
    featured: false,
  },
]

const faqs = FAQS

const testimonials = [
  {
    quote:
      'Dulu kasir sering antre dan stok sering telat dicatat. Sekarang satu transaksi nggak sampai 15 detik, laporan laba tinggal lihat di HP.',
    name: 'Sari Wulandari',
    role: 'Pemilik Warung Sari — Cilacap',
  },
  {
    quote:
      'Internet sempat mati pas jam ramai, tetap bisa jualan. Pas internet balik, datanya langsung nyambung semua. Ini penyelamat.',
    name: 'Andi Pratama',
    role: 'Owner Kedai Kopi Senja — Bandung',
  },
  {
    quote:
      'Dari gerobak, modal kecil, jadi nggak mau bayar mahal. Rp 39rb sebulan dapat fitur yang dulu cuma ada di POS mahal.',
    name: 'Budi Santoso',
    role: 'Gerobak Seblak Gacor — Jakarta',
  },
]
---

<Layout jsonLd={[productJsonLd()]} faqs={faqs}>
  <main>
    <!-- ============ HERO (2C.1) — static-first, CSS only ============ -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-inner">
        <p class="hero-badge">Mulai Rp {(PLANS.starter.monthly / 1000).toLocaleString('id-ID')}rb/bulan</p>
        <h1 id="hero-title" class="hero-title">
          POS F&B yang Bikin <span class="accent">Laris</span>, Harga Warung
        </h1>
        <p class="hero-sub">
          Kasir cepat di bawah 15 detik, laporan laba otomatis, dan tetap jalan saat
          internet offline. Cukup buka aplikasi, langsung jualan.
        </p>
        <div class="hero-ctas">
          <!-- Wiring ke web app (app.larispos.id) dilakukan saat domain web tersedia -->
          <a class="btn btn-primary" href="/register">Coba Gratis 14 Hari</a>
          <a class="btn btn-secondary" href="#fitur">Lihat Fitur</a>
        </div>
        <ul class="hero-bullets">
          <li>Kasir cepat &lt;15 detik</li>
          <li>Laporan laba otomatis</li>
          <li>Tetap jalan saat offline</li>
        </ul>
      </div>
    </section>

    <!-- ============ FITUR (2C.2) ============ -->
    <section id="fitur" class="section" aria-labelledby="fitur-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2 id="fitur-title">Fitur yang Bikin Jualan Makin Gampang</h2>
          <p class="section-lead">
            Enam fitur inti untuk UMKM F&B — dari kasir sampai laporan, semua dalam satu aplikasi.
          </p>
        </div>
        <div class="feature-grid" data-reveal="stagger">
          {features.map((f) => (
            <article class="feature-card" data-hover>
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  {f.icon === 'bolt' && <path d="M13 2L4 14h6l-1 8 9-12h-6l1-8z" />}
                  {f.icon === 'wifi-off' && (<><path d="M2 8.5a15 15 0 014-2.5M8 5a15 15 0 0112 3.5" /><path d="M5 12a10 10 0 013-2M12 9a10 10 0 017 3" /><path d="M2 2l20 20" /><path d="M9 15a5 5 0 014-1.7" /><circle cx="12" cy="19" r="1" /></>)}
                  {f.icon === 'chart' && (<><path d="M3 3v18h18" /><path d="M7 15l3-4 3 2 5-7" /></>)}
                  {f.icon === 'box' && (<><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z" /><path d="M3 7l9 4 9-4M12 11v10" /></>)}
                  {f.icon === 'store' && (<><path d="M3 9l1.5-5h15L21 9" /><path d="M3 9a3 3 0 006 0 3 3 0 006 0 3 3 0 006 0" /><path d="M5 11v9h14v-9" /></>)}
                  {f.icon === 'printer' && (<><path d="M6 9V2h12v7" /><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2" /><path d="M6 14h12v8H6z" /></>)}
                </svg>
              </span>
              <h3>{f.title}</h3>
              <p>{f.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ HARGA (2C.2) ============ -->
    <section id="harga" class="section" aria-labelledby="harga-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2 id="harga-title">Harga yang Ramah di Kantong</h2>
          <p class="section-lead">
            Mulai Rp 39rb/bulan, bayar tahunan hemat 17%. Semua paket bisa dicoba gratis 14 hari — tanpa kartu kredit.
          </p>
        </div>
        <div class="pricing-grid" data-reveal="stagger">
          {plans.map((p) => (
            <article class={`pricing-card${p.featured ? ' featured' : ''}`} data-hover>
              {p.featured && <span class="pricing-badge">PALING LARIS</span>}
              <h3 class="pricing-name">{p.label}</h3>
              <p class="pricing-tagline">{p.tagline}</p>
              <p class="pricing-price">
                {ribuan(p.monthly)}<small>/bulan</small>
              </p>
              <p class="pricing-yearly">
                {p.yearly
                  ? `Bayar tahunan ${ribuan(p.yearly)} (≈ ${ribuan(p.yearly / 12)}/bln) — hemat ${Math.round((1 - p.yearly / 12 / p.monthly) * 100)}%`
                  : 'Penagihan custom — konsultasi gratis'}
              </p>
              <ul class="pricing-features">
                {p.features.map((f) => <li>{f}</li>)}
              </ul>
              <a class="btn btn-primary" href="/register">Coba Gratis 14 Hari</a>
            </article>
          ))}
        </div>
        <p class="section-note">
          Harga belum termasuk pajak. Upgrade, downgrade, atau berhenti kapan saja — tanpa kontrak.
        </p>
      </div>
    </section>

    <!-- ============ TESTIMONI (2C.2, dummy) ============ -->
    <section id="testimoni" class="section" aria-labelledby="testimoni-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2 id="testimoni-title">Kata Mereka yang Sudah Jualan</h2>
          <p class="section-lead">Cerita dari warung, kedai kopi, dan gerobak yang pindah ke LarisPOS.</p>
        </div>
        <div class="testimonial-grid" data-reveal="stagger">
          {testimonials.map((t) => (
            <figure class="testimonial-card" data-hover>
              <blockquote class="testimonial-quote">{t.quote}</blockquote>
              <figcaption>
                <h3 class="testimonial-name">{t.name}</h3>
                <p class="testimonial-role">{t.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FAQ (2C.2) — accordion native HTML, tanpa JS ============ -->
    <section id="faq" class="section" aria-labelledby="faq-title" data-reveal>
      <div class="container">
        <div class="section-head">
          <h2 id="faq-title">Pertanyaan yang Sering Ditanya</h2>
          <p class="section-lead">Masih ragu? Ini jawaban untuk pertanyaan yang paling sering kami terima.</p>
        </div>
        <div class="faq-list" data-reveal="stagger">
          {faqs.map((f) => (
            <details class="faq-item" name="faq">
              <summary>{f.q}</summary>
              <p class="faq-answer">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CTA BANNER (2C.2) ============ -->
    <section class="section" aria-labelledby="cta-title" data-reveal>
      <div class="container">
        <div class="cta-banner" data-hover>
          <h2 id="cta-title">Mulai Jualan Hari Ini</h2>
          <p class="cta-sub">
            Gratis 14 hari, tanpa kartu kredit, tanpa kontrak. Siap berjualan dalam 15 menit.
          </p>
          <a class="btn btn-primary" href="/register">Coba Gratis 14 Hari</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
